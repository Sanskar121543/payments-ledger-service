# Copy to terraform.tfvars (gitignored) and fill in. Credentials are NOT set here: the provider reads
# the API key from ~/.oci/config.

tenancy_ocid     = "ocid1.tenancy.oc1..paste-the-tenancy-line-from-your-oci-config"
region           = "us-ashburn-1"
ssh_allowed_cidr = "203.0.113.7/32" # your public IP: curl https://checkip.amazonaws.com

# Optional:
# availability_domain_number = 1      # wait-and-apply.sh sets this to the domain that had room
# ocpus                      = 4      # Always Free: at most 4 OCPUs and 24 GB in total
# memory_in_gbs              = 24
# boot_volume_size_in_gbs    = 100    # Always Free: 200 GB of block storage in total
# compose_profile            = "full" # or "lite"; read by deploy.sh
