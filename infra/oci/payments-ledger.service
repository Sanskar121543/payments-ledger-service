# Starts the stack at boot, so it comes back after a reboot or after Oracle stops an idle Always Free VM and you
# start it again. Installed by vm-deploy.sh. The profile comes from COMPOSE_PROFILES in .env.
[Unit]
Description=payments-ledger-service (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
WorkingDirectory=/opt/payments-ledger-service
ExecStart=/usr/bin/docker compose up -d --wait
# Both profiles, so switching COMPOSE_PROFILES from full to lite also stops app2, app3 and Grafana.
ExecStop=/usr/bin/docker compose --profile lite --profile full stop
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
