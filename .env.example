# Copy this file to .env (which is gitignored) and change the values.
# Everything here is a local-only demo credential for synthetic data.

# Host ports (change them if something else on your machine already uses one).
HTTP_PORT=8088
POSTGRES_PORT=5432
KAFKA_PORT=9094
KAFBAT_PORT=8090
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ledger

# Clients send DEMO_API_KEY in the X-API-Key header. The app only knows its SHA-256 hash.
# Generate your own pair with: scripts/new-api-key.sh
DEMO_API_KEY=pls_demo_local_only_4f9c2b7e1a
API_KEY_HASHES=demo:88808a1d0df44dcbd0b17cf2d2e5e19126a747a456c07088f5e4d05767beaa2d

# Grafana admin login (anonymous visitors get read-only access to the dashboard).
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Written into every load-test result file. Describe the machine that ran it, in double quotes, e.g.
# HARDWARE_NOTE="AMD Ryzen 9 7845HX (12 cores / 24 threads), 15.2 GB RAM, Windows 11, Docker Desktop"
HARDWARE_NOTE=
